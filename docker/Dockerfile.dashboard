FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock* ./
RUN uv sync --frozen --no-dev --no-install-project || uv sync --no-dev --no-install-project

COPY src ./src
COPY app ./app
COPY models ./models

EXPOSE 8501

CMD ["uv", "run", "streamlit", "run", "app/dashboard/streamlit_app.py", "--server.port=8501", "--server.address=0.0.0.0"]
